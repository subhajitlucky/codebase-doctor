{
  "name": "codebase-doctor",
  "version": "0.4.9",
  "mcpName": "io.github.subhajitlucky/codebase-doctor",
  "description": "Verification for agent-written code: evidence-backed findings, honest coverage.",
  "type": "module",
  "bin": {
    "codebase-doctor": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs/*.md",
    "docs/plans/*.md",
    ".agents/skills/codebase-doctor",
    "CHANGELOG.md",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/cli.ts src/index.ts --format esm --clean && tsc -p tsconfig.build.json",
    "bundle": "npm run build && node scripts/build-mcpb.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "red-team": "npm run build && node scripts/red-team.mjs",
    "differential": "npm run build && node scripts/differential.mjs",
    "study:agents": "node scripts/study-agent-repos.mjs",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude test/integration/packed-cli.test.ts --exclude test/integration/package-report-output.test.ts",
    "test:package": "npm run build && node scripts/check-package.mjs && vitest run test/integration/package-report-output.test.ts && vitest run test/integration/packed-cli.test.ts",
    "test:rls-integration": "npm run build && node scripts/run-rls-integration.mjs",
    "version": "node scripts/sync-version.mjs",
    "ci": "npm run typecheck && npm test && npm run build",
    "ci:full": "npm run ci && npm run test:package && node scripts/red-team.mjs && npm audit --audit-level=high",
    "prepare": "npm run build"
  },
  "keywords": [
    "codebase",
    "diagnostics",
    "static-analysis",
    "code-audit",
    "impact-analysis",
    "sarif",
    "secrets-scanning",
    "dependency-audit",
    "developer-tools",
    "ai-agents",
    "mcp-server",
    "cli",
    "testing",
    "repository-audit"
  ],
  "author": "Subhajit Pradhan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subhajitlucky/codebase-doctor.git"
  },
  "homepage": "https://github.com/subhajitlucky/codebase-doctor#readme",
  "bugs": {
    "url": "https://github.com/subhajitlucky/codebase-doctor/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@babel/parser": "8.0.4",
    "@modelcontextprotocol/sdk": "1.32.1",
    "commander": "^15.0.0",
    "jsonc-parser": "3.3.1",
    "pg": "^8.23.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}

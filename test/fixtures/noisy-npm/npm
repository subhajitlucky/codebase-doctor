#!/usr/bin/env node

const { readFileSync } = process.getBuiltinModule("node:fs");
const { version } = JSON.parse(readFileSync("package.json", "utf8"));

const requiredFiles = [
  "dist/cli.js",
  "dist/index.js",
  "dist/index.d.ts",
  "README.md",
  "CHANGELOG.md",
  "LICENSE",
  "docs/architecture.md",
  ".agents/skills/codebase-doctor/SKILL.md",
  ".agents/skills/codebase-doctor/agents/openai.yaml",
];

process.stdout.write("CLI Building entry: src/cli.ts, src/index.ts\n");
process.stdout.write(`${JSON.stringify([
  {
    id: `codebase-doctor@${version}`,
    name: "codebase-doctor",
    version,
    size: 123,
    files: requiredFiles.map((path) => ({ path })),
  },
], null, 2)}\n`);
